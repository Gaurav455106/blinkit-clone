# Settings for `npm run dev`.
#
# WARNING: `.env` is committed to git (it only holds public VITE_ values).
# Put every server-only value below in `.env.local`, which git ignores.

# ── Website (public: these are built into the browser bundle) ────────────────
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Server only: put these in .env.local, never in .env (used by /api; never prefix with VITE_)
# Supabase → Project Settings → API → service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=
# Optional: defaults to VITE_SUPABASE_URL
SUPABASE_URL=
# At least 32 random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Optional emergency staff sign-in. At least 16 characters; leave empty to turn it off.
MASTER_KEY=
# Optional: defaults to https://ksstudentshub.vercel.app
HUB_URL=
